# This is a template, not a real secrets file -- it is safe to commit
# because it holds no real values. When you deploy on Streamlit Community
# Cloud, paste the keys you actually have into the app's own "Secrets" box
# (App settings -> Secrets) in this same TOML format; you never need to
# create a real .streamlit/secrets.toml file yourself, on this machine or
# anywhere else. If you ever do, for local testing, .gitignore already
# excludes it from git.

# Whichever of these is set runs the whole pipeline -- search, planning,
# extraction and writing. With more than one set, Gemini is used by default,
# then Groq, then Claude (Gemini and Groq both have free tiers). Leave a
# line out entirely if you don't have that key yet.
ANTHROPIC_API_KEY = "your-anthropic-key-here"
GEMINI_API_KEY = "your-gemini-key-here"
GROQ_API_KEY = "your-groq-key-here"

# There is deliberately no OLLAMA_HOST entry here. The fourth provider,
# ollama, runs a model on whatever machine research-assistant itself runs
# on -- for a Streamlit Community Cloud deployment that machine is the
# hosting server, not yours, so there is no "localhost" for it to reach and
# no secret that would make it work there. ollama only ever works running
# this app locally, with `ollama serve` running on the same machine.

# Web search: set ONE of these two, not both.
TAVILY_API_KEY = "your-tavily-key-here"
# SERPER_API_KEY = "your-serper-key-here"

# Optional but recommended -- the keyless Semantic Scholar pool is shared by
# everyone and heavily throttled.
SEMANTIC_SCHOLAR_API_KEY = "your-semantic-scholar-key-here"

# A password you choose yourself. Once this is set, anyone who opens the
# deployed link is asked for it before they can run a question -- this is
# what stops a stranger with the link from spending your API quota. Leave
# this line out entirely to leave the site open to anyone with the link.
APP_PASSWORD = "choose-a-password-here"
