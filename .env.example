# Copy this file to .env and fill in the values you have.
# Nothing here is required just to install the project or run
# scripts/check_setup.py -- that script will tell you exactly which of
# these are missing and which features they unlock.

# Set ONE of ANTHROPIC_API_KEY or GEMINI_API_KEY (or both, and switch
# between them with --provider / the web UI's model dropdown). Whichever
# one is active runs the whole pipeline: search, planning, extraction and
# writing. With both set, Gemini is used by default -- it has a free tier.

# Get one at https://console.anthropic.com/ (API Keys section).
ANTHROPIC_API_KEY=

# Free tier, no card required -- get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Web search: set ONE of these two, not both.
# Tavily -- https://tavily.com/ -- free "Researcher" tier includes 1,000
# search credits/month, no card required. Recommended default.
TAVILY_API_KEY=
# Serper -- https://serper.dev/ -- alternative to Tavily.
SERPER_API_KEY=

# Technically optional, practically recommended: Semantic Scholar's keyless
# pool is shared by everyone and heavily throttles the /paper/search
# endpoint (measured testing has seen most keyless search requests
# rejected). A free key guarantees 1 request/second instead.
# Request one at https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# arXiv needs no key -- its API is fully open. Nothing to add here.
