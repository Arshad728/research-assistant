# Copy this file to .env and fill in the values you have.
# Nothing here is required just to install the project or run
# scripts/check_setup.py -- that script will tell you exactly which of
# these are missing and which features they unlock.

# Set ONE of ANTHROPIC_API_KEY, GEMINI_API_KEY, or GROQ_API_KEY (or more
# than one, and switch between them with --provider / the web UI's model
# dropdown). Whichever one is active runs the whole pipeline: search,
# planning, extraction and writing. With more than one set, Gemini is used
# by default, then Groq, then Claude -- both Gemini and Groq have free tiers.

# Get one at https://console.anthropic.com/ (API Keys section).
ANTHROPIC_API_KEY=

# Free tier, no card required -- get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free tier, no card required, more generous daily limit than Gemini's --
# get one at https://console.groq.com/keys
GROQ_API_KEY=

# --provider ollama needs no key at all -- it runs a model on your own
# machine instead of calling a hosted API. Install Ollama from
# https://ollama.com, run `ollama serve`, then `ollama pull qwen3:8b` (the
# default model this provider asks for). Leave OLLAMA_HOST unset to use the
# default, http://localhost:11434; set it only if your server runs
# somewhere else. This only ever works when the machine running
# research-assistant is the same one running `ollama serve` -- it does NOT
# work for the deployed Streamlit Cloud version of this app, since
# "localhost" there is the hosting server, not yours.
OLLAMA_HOST=

# Web search: set ONE of these two, not both.
# Tavily -- https://tavily.com/ -- free "Researcher" tier includes 1,000
# search credits/month, no card required. Recommended default.
TAVILY_API_KEY=
# Serper -- https://serper.dev/ -- alternative to Tavily.
SERPER_API_KEY=

# Technically optional, practically recommended: Semantic Scholar's keyless
# pool is shared by everyone and heavily throttles the /paper/search
# endpoint (measured testing has seen most keyless search requests
# rejected). A free key guarantees 1 request/second instead.
# Request one at https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=

# arXiv needs no key -- its API is fully open. Nothing to add here.
